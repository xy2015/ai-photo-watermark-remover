# ── AI 去水印 环境变量配置 ──
# 复制为 .env 后修改: cp .env.example .env

# 服务配置
HOST=0.0.0.0
PORT=5000
DEBUG=true
SECRET_KEY=dev-secret-change-me

# Gunicorn（仅生产环境）
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# 前端 API 地址（生产部署时改为实际域名）
API_BASE_URL=http://localhost:5000/api

# 前端静态文件路径（Docker 部署时设为 /app/static）
STATIC_FOLDER=
